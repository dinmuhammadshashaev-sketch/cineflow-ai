# Server-Side Environment Variables (Placeholders only - Never commit raw secrets)

# GEMINI_API_KEY alone is not sufficient for the guarded LIVE 8-agent workflow.
# LIVE workflow requires Vertex AI configuration, Google Cloud credentials/ADC, and Parallel readiness.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
CINEFLOW_GEMINI_MODEL=gemini-2.5-flash-lite
PARALLEL_API_KEY=
